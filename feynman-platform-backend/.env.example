# 服务端环境变量示例：复制为 .env 后填入真实值
# 注意：.env 不要提交到 Git

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_string
PORT=3000

# 百度智能云语音识别（第七次课）
# 在百度智能云控制台 -> 语音技术 -> 创建应用后获取
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# DeepSeek 开放平台（第八次课：AI 润色与智能评价）
# 在 https://platform.deepseek.com/api_keys 创建 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 低于该分数时，自动把知识点加入复习列表
AI_REVIEW_THRESHOLD=60
